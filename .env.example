DEVFLOW_DB_PATH=runtime_data/devflow.db
DEVFLOW_REPORT_DIR=runtime_data/reports
DEVFLOW_TOOL_MODE=mcp
DEVFLOW_MCP_TIMEOUT_SECONDS=10
DEVFLOW_MCP_MAX_RETRIES=1
DEVFLOW_MAX_STEPS=8
DEVFLOW_MAX_REPLANS=2
DEVFLOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000

# DeepSeek is optional; deterministic mode remains available without a key.
DEVFLOW_LLM_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
DEVFLOW_LLM_TIMEOUT_SECONDS=30
DEVFLOW_LLM_MAX_TOKENS=4096
DEVFLOW_LLM_FALLBACK_ENABLED=true

# Enterprise Knowledge Copilot. Keep fixture for offline demos; switch to remote for integration.
DEVFLOW_KNOWLEDGE_MODE=fixture
KNOWLEDGE_API_BASE=http://192.168.1.50:8100
KNOWLEDGE_API_TOKEN=
KNOWLEDGE_TIMEOUT_SECONDS=35
KNOWLEDGE_MAX_RETRIES=1
KNOWLEDGE_FIXTURE_FALLBACK=true
